{
  "name": "jobber-notification-server",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "pm2 start build/src/app.js -i 5 --attach --watch | pino-pretty -c",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "dev": "nodemon -r tsconfig-paths/register src/app.ts | pino-pretty -c",
    "lint:check": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "prettier:check": "prettier --check 'src/**/*.{ts,js,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,js,json}'",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json && ts-node tools/copyAssets.ts",
    "test": "jest --coverage=true -w-1 --forceExit --detectOpenHandles --watchAll=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/amqplib": "^0.10.8",
    "@types/email-templates": "^10.0.4",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/shelljs": "^0.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@SiarhKul/jobber-shared": "^0.0.4",
    "amqplib": "^2.2.1",
    "dotenv": "^18.0.9",
    "ejs": "^3.1.10",
    "email-templates": "^13.0.1",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "http-status-codes": "^2.3.0",
    "nodemailer": "^10.3.1",
    "pino-pretty": "^13.2.0",
    "pm2": "^7.1.2",
    "shelljs": "^0.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "typescript-transform-paths": "^4.0.0",
    "winston": "^3.19.0"
  }
}
